{
	"name": "ptt-mock",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie url preferredLanguage baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie url preferredLanguage baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:db": "docker compose -f compose.test.yaml up -d --wait && tests/fixtures/load.sh",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "vitest run && playwright test",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "3.2.2",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-vercel": "^7.0.4",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^22.20.5",
		"autoprefixer": "^10.6.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^3.4.19",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@vercel/analytics": "^2.0.1",
		"drizzle-orm": "^0.45.4",
		"leaflet": "1.9.4",
		"postgres": "^4.1.1",
		"svelte-modals": "^2.0.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
